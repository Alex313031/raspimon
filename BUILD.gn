# raspimon BUILD.gn file.

declare_args() {
  # Whether the frontends link the shared libraspimon.so instead of the
  # static archive (both library flavors always build). Set with
  # `gn gen out --args="shared_libraspimon=true"`. Note: GN has no
  # statement terminators - a trailing ';' here is a syntax error
  shared_libraspimon = false
}

group("raspimon_all") {
  # Labels in the same file need the leading ':' (a bare name would be
  # read as a path to another BUILD.gn file)
  deps = [
    ":libraspimon_shared",
    ":libraspimon_static",
    ":raspimon",
    ":raspimon_gui",
  ]
}

# One source list, two library flavors below. Both set output_name
# "raspimon" so the artifacts come out as libraspimon.a / libraspimon.so
libraspimon_sources = [
  "src/libraspimon/gencmd.cc",
  "src/libraspimon/gencmd.h",
  "src/libraspimon/libraspimon.h",
  "src/libraspimon/pch.h",
  "src/libraspimon/utils.cc",
  "src/libraspimon/utils.h",
]

static_library("libraspimon_static") {
  configs += [ ":raspimon_config" ]

  # GCC-style PCH: GN precompiles precompiled_source (the header itself)
  # into a .gch and force-includes it into every compile
  precompiled_header = "src/libraspimon/pch.h"
  precompiled_source = "src/libraspimon/pch.h"
  sources = libraspimon_sources

  output_name = "raspimon"
}

shared_library("libraspimon_shared") {
  configs += [ ":raspimon_config" ]

  defines = [ "LIBRASPIMON_SHARED=1" ]

  precompiled_header = "src/libraspimon/pch.h"
  precompiled_source = "src/libraspimon/pch.h"
  sources = libraspimon_sources

  output_name = "raspimon"
}

executable("raspimon") {
  configs += [ ":raspimon_config" ]

  precompiled_header = "src/console/pch.h"
  precompiled_source = "src/console/pch.h"
  sources = [
    "src/console/console_utils.cc",
    "src/console/console_utils.h",
    "src/console/pch.h",
    "src/console/raspimon.cc",
    "src/console/raspimon.h",
  ]
  include_dirs = [ "./src/console" ]

  if (shared_libraspimon) {
    # Lets ShowVersion() report "Using (shared)" instead of "Built with"
    defines = [ "LIBRASPIMON_SHARED=1" ]
    deps = [ ":libraspimon_shared" ]
  } else {
    deps = [ ":libraspimon_static" ]
  }

  output_name = "raspimon"
}

executable("raspimon_gui") {
  configs += [
    ":raspimon_config",

    # NOTE: this config only exists in a Chromium-style checkout (it wraps
    # pkg-config gtk+-3.0); a standalone GN setup needs a local config
    # providing the same cflags/libs
    "//build/config/linux:gtk",
  ]

  precompiled_header = "src/gui/pch.h"
  precompiled_source = "src/gui/pch.h"
  sources = [
    "src/gui/gui_utils.cc",
    "src/gui/gui_utils.h",
    "src/gui/pch.h",
    "src/gui/raspimon_gui.cc",
    "src/gui/raspimon_gui.h",
  ]
  include_dirs = [ "./src/gui" ]

  if (shared_libraspimon) {
    # Lets the About dialog report "Using (shared)" instead of "Built with"
    defines = [ "LIBRASPIMON_SHARED=1" ]
    deps = [ ":libraspimon_shared" ]
  } else {
    deps = [ ":libraspimon_static" ]
  }

  output_name = "raspimon-gui"
}

config("raspimon_config") {
  include_dirs = [ "./src/libraspimon" ]
  cflags_c = [ "-std=c17", ]
  cflags_cc = [ "-std=c++17", ]

  # Mirror the Makefile's IS_DEBUG defines; `is_debug` is GN's standard
  # debug-build argument (set with `gn gen --args="is_debug=true"`)
  if (is_debug) {
    defines = [ "DEBUG", "_DEBUG" ]
  } else {
    defines = [ "NDEBUG", "_NDEBUG" ]
  }

  libs = [ "m" ]
}
