# raspimon BUILD.gn file.

executable("raspimon") {
  configs += [ ":raspimon_config" ]

  # GCC-style PCH: GN precompiles precompiled_source (the header itself) into
  # a .gch and adds "-include pch.h" to every compile. precompiled_header is
  # only read by MSVC-style PCH toolchains, where it must match the string in
  # the #include directive and pch.cc becomes the /Yc source.
  precompiled_header = "pch.h"
  precompiled_source = "src/pch.h"
  sources = [
    "src/gencmd.cc",
    "src/gencmd.h",
    "src/pch.cc",
    "src/pch.h",
    "src/raspimon.cc",
    "src/raspimon.h",
    "src/utils.cc",
    "src/utils.h",
  ]

  output_name = "raspimon"
}

config("raspimon_config") {
  include_dirs = [ "./src" ]
  cflags_cc = [ "-std=c++17", ]

  # Mirror the Makefile's IS_DEBUG defines; `is_debug` is GN's standard
  # debug-build argument (set with `gn gen --args="is_debug=true"`)
  if (is_debug) {
    defines = [ "DEBUG", "_DEBUG" ]
  } else {
    defines = [ "NDEBUG", "_NDEBUG" ]
  }
}
